@baseUrl = http://localhost:8000/api/v1
@token = your_jwt_token_here
@projectId = 6a15a0b96184a8ed252a498b
@memberId = 699c5c7965ff60525cf68d87
@userId = 6a159cecded1a4b897fb8e66
@taskId = 6a19a070ffb3989ccb563c1d
@subTaskId = 6a15ac326c3ab5a6ae0f8ff0
@noteId = 6a15ac526c3ab5a6ae0f8ff5
@unHashedToken = your_email_verification_token_here

### ─────────────────────────────────────
### HEALTHCHECK
### ─────────────────────────────────────

### Healthcheck
GET {{baseUrl}}/healthcheck

### ─────────────────────────────────────
### AUTH
### ─────────────────────────────────────

### Register
POST {{baseUrl}}/users/register
Content-Type: application/json

{
  "userName": "testuser2",
  "email": "test2@example.com",
  "password": "Password@123"
}

###

### Verify email
POST {{baseUrl}}/users/verify/{{unHashedToken}}

###

### Login
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "Password@123"
}

###

### Logout
GET {{baseUrl}}/users/logout
Authorization: Bearer {{token}}

###

### Update account details
PATCH {{baseUrl}}/users/updateDetails
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "newUserName": "testuser2"
}

###

### Update avatar
PATCH {{baseUrl}}/users/updateAvatar
Authorization: Bearer {{token}}
Content-Type: multipart/form-data

###

### Resend verify email
POST {{baseUrl}}/users/resendVerifyEmail

###

### Reset password
POST {{baseUrl}}/users/resetPassword
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "password": "Password@123",
  "newPassword": "NewPassword@123"
}

###

### Forgot password
POST {{baseUrl}}/users/forgotPassword
Content-Type: application/json

{
  "email": "test@example.com"
}

###

### Get profile
GET {{baseUrl}}/users/profile
Authorization: Bearer {{token}}

###

### Refresh access token
GET {{baseUrl}}/users/refreshAccessToken

### ─────────────────────────────────────
### PROJECTS (mounted at /api/v1/projects)
### ─────────────────────────────────────

### Get all projects
GET {{baseUrl}}/projects/project
Authorization: Bearer {{token}}

###

### Create project
POST {{baseUrl}}/projects/project
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "My Project",
  "description": "A sample project description"
}

###

### Get project by ID
GET {{baseUrl}}/projects/{{projectId}}
Authorization: Bearer {{token}}

###

### Update project
PATCH {{baseUrl}}/projects/{{projectId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Updated Project Name",
  "description": "Updated description"
}

###

### Delete project
DELETE {{baseUrl}}/projects/{{projectId}}
Authorization: Bearer {{token}}

### ─────────────────────────────────────
### PROJECT MEMBERS
### ─────────────────────────────────────

### Get project members
GET {{baseUrl}}/projects/{{projectId}}/members
Authorization: Bearer {{token}}

###

### Add member to project
POST {{baseUrl}}/projects/{{projectId}}/members
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "userId": "{{userId}}",
  "role": "member"
}

###

### Update member role
PATCH {{baseUrl}}/projects/{{projectId}}/members/{{memberId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "newRole": "projectAdmin"
}

###

### Remove member from project
DELETE {{baseUrl}}/projects/{{projectId}}/members/{{memberId}}

###

### Add member (alternate GET route)
GET {{baseUrl}}/projects/{{projectId}}/addMember/{{userId}}
Authorization: Bearer {{token}}
Authorization: Bearer {{token}}

### ─────────────────────────────────────
### TASKS
### ─────────────────────────────────────

### Get tasks for a project
GET {{baseUrl}}/project/task/{{projectId}}
Authorization: Bearer {{token}}

###

### Create task in project
POST {{baseUrl}}/project/task/{{projectId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "taskTitle": "Sample task",
  "assignedUser": "{{userId}}"
}

###

### Get task by ID
GET {{baseUrl}}/project/task/{{projectId}}/{{taskId}}
Authorization: Bearer {{token}}

###

### Update task
PATCH {{baseUrl}}/project/task/{{projectId}}/{{taskId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "taskStatus": "in_progress",
  "taskTitle": "Updated title",
  "taskDescription": "Updated description"
}

###
### To get tasks status
GET {{baseUrl}}/project/task/{{taskId}}/stats


###

### Delete task
DELETE {{baseUrl}}/project/task/{{projectId}}/{{taskId}}
Authorization: Bearer {{token}}

### ─────────────────────────────────────
### SUBTASKS
### ─────────────────────────────────────

### Create subtask
POST {{baseUrl}}/project/task/subtask/{{projectId}}/{{taskId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Sample subtask3"
}

###

### Update subtask
PATCH {{baseUrl}}/project/task/subtask/{{projectId}}/{{subTaskId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "subtaskStatus": true,
  "subtaskTitle": "Updated subtask title"
}

###

### Delete subtask
DELETE {{baseUrl}}/project/task/subtask/{{projectId}}/{{subTaskId}}
Authorization: Bearer {{token}}

### ─────────────────────────────────────
### NOTES
### ─────────────────────────────────────

### Get note by ID
GET {{baseUrl}}/project/notes/{{projectId}}/{{noteId}}
Authorization: Bearer {{token}}

###

### Get notes
GET {{baseUrl}}/project/notes/{{projectId}}/getNotes
Authorization: Bearer {{token}}

###

### Create note
POST {{baseUrl}}/project/notes/{{projectId}}/createNote
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "content": "Note content"
}

###

### Update note
PATCH {{baseUrl}}/project/notes/{{projectId}}/{{noteId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "content": "Updated note content"
}

###

### Delete note
DELETE {{baseUrl}}/project/notes/{{projectId}}/{{noteId}}
Authorization: Bearer {{token}}


